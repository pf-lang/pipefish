~~ Prints things out for the user or for debugging.

import private

pho::"phonemes.pf"
"strings"

def

~~ Displays word lists.
display(M map) :
    len(M) == 0 :
        "Vocab list is empty."
    else :
        from a = "" for _::k = range lists.sort keys M :
            a + "▪ " + k + " - " + M[k] + "\n"

ppRules(rules list) :
    from a = "" for i::rule = range rules :
        a + pad(string(i)+".", 5) + rule[flavor] + " -- " + makeString(rule[body]) + "\n"

makeString(sn snippet) :
    from a = "" for _::el = range sn :
        a + string(el)

private

mapToOrderedList(M map) -> list :
    lists.sort from L = [] for k::v = range M :
        L & (k::v) 

pad(s string, w int) :
    len(s) > w :
        error "string too wide to pad"
    else :
        s + strings.repeat(" ", w-len s)

