import private

"lists"

NULL::"files"
NULL::"lexer.pf"
NULL::"printer.pf"
NULL::"evaluator.pf"
NULL::"parser.pf"
pho::"phonemes.pf"

newtype

Rule = struct(flavor string, body snippet)

var

words = map()
rules = []

private

currentFile string? = NULL
recentChanges map? = NULL

cmd

~~ Adds a list of words to the vocab list.
add(sn snippet) :
    retcon len(rules), sn

~~ Borrows words into the language, conforming them to the phoneme inventory.
borrow(sn snippet) :
    setWords ((combine words, (sn -> tokenize -> parseWordList -> assimilate(that, inv))) ..
              .. -> fixAll(that, (rules ?> that[flavor] == "fix")))
given :
    inv = getPhonemesFrom words

~~ Deletes words from the vocab list.
// We don't use `setWords` 'cos there wouldn't be anything to show, maybe have it construct its
// own diff?
delete(sn snippet) : 
    words = words without ((sn -> makeString -> strings.split that, "\n") ...)

~~ Shows which entries in the word list have been changed by the most recent command.
diff :
    recentChanges in null :
        post "There are no recent changes."
    else :
        post display recentChanges

~~ Creates a permanent law of the phonology.
fix(sn snippet) :
    rules = rules & Rule("fix", sn)
    setWords fixAll(words, (rules ?> that[flavor] == "fix"))

~~ Shows the history of the sound changes.
history :
    rules == [] :
        post "No history has happened yet."
    else :
        post ppRules rules

~~ Lists the phonemes currrently in the language.
inventory :
    post getPhonemesFrom words

~~ Merges a file containing a list of words into the vocab.
merge(filename string) :
    get text from File(filename)
    add snippet(text)

~~ Adds a note to the history.
note(sn snippet) :
   rules = rules & Rule("note", sn)

~~ Deletes the project in-memory, though not on disk if you've saved it.
nuke :
    words = map()
    rules = []
    currentFile = NULL 
    recentChanges = NULL

~~ Opens a saved project.
open (filename string):
    get text from File(filename)
    data = [(eval text)] // TODO --- this is a hack because `eval` is behaving weirdly when returning tuples.
    currentFile = filename
    words = data[0]
    rules = data[1]

~~ Retcons a list of words into the vocab list at the start.
retcon(sn snippet) :
    retcon 0, sn

~~ Retcons a list of words into the vocab list at a point just prior to event `i`.
retcon(i int, sn snippet) :
    setWords ((combine words, 
                  .. (sn -> tokenize -> parseWordList ..
                      .. -> apply that, (rules[i::len rules] ?> that[flavor] == "shift"))) ..
         .. -> fixAll(that, (rules ?> that[flavor] == "fix")))

~~ Retcons a file containing a list of words into the vocab at the start.
retcon merge(filename string) :
    get text from File(filename)
    retcon 0, snippet(text)

~~ Retcons a file containing a list of words into the vocab at the start.
retcon merge(i int, filename string) :
    get text from File(filename)
    retcon i, snippet(text)

~~ Saves the project to the given file.
save as (filename string) :
    put (literal words, rules) into File(filename)
    currentFile = filename

save :
    currentFile in string :
        save as currentFile
    else :
        error "you can't use `save` before you've used `save as` to select a filename"

~~ Applies a sound change.
shift(sn snippet) :
    setWords (changeAll(words, sn) -> fixAll(that, (rules ?> that[flavor] == "fix")))
    rules = rules & Rule("shift", sn)

~~ Displays the vocab list.
vocab :
    post display words
   
private

// Makes sure we set the diff when we set the words.
setWords(newWords map) :
    recentChanges = getDiff(words, newWords)
    words = newWords

def       

~~ Describes the phonological properties of a phoneme.
describe(sn snippet) -> string :
    ph -> getSets ?> not (that in ["C", "V", "consonant", "vowel"] ..
                       .. or len(that) > 4 and that[0::4] == "non-") ..
     .. -> strings.join(that, " ") + cOrV 
given :
    ph = makeString sn 
    cOrV = (ph in pho.CONSONANT : " consonant" ; else : " vowel")


~~ Returns the phonemes matching a given pattern.
phonemes(sn snippet) :
    sn -> parse -> evaluateSet

private

getDiff(M, N map) -> map :
    from A = map() for k::v = range N :
        not k in keys M or M[k] != v :
            A with k::v 
        else :
            continue

getSets(ph string) :
    from L = [] for name::class = range pho.MAP :
        ph in class :
            L & name
        else :
            continue

fixAll(words map, rules list) :
    from M = words for :
        M == newWords :
            break M 
        else :
            newWords
    given : newWords = apply(M, rules)

getPhonemesFrom(words map) :
    from S = set() for k::_ = range words :
        S + set(pho.split(k) ...)

apply(words map, rules list) :
    from M = words for _::rule = range rules :
        changeAll(M, rule[body])

changeAll(words map, sn snippet) :
    from M = map() for k::v = range words :
        M plus ((replaceAll k, sn)::v)

combine(M, N map) :
    from m = M for k::v = range N :   
        m plus (k::v)

(M map) plus (P pair) -> map :
    P[0] in keys M and P[1] != M[P[0]] :
        M with P[0]::M[P[0]]+", "+P[1]
    else :
        M with P

replaceAll(word string, pattern snippet) : 
    from a = word for :
        newWord == a :
            break
        else :
            newWord
    given :
        newWord = replaceOnce a, pattern

replaceOnce(word string, pattern snippet) :
    start in null :
        word 
    else :
        (lists.sum phos[0::start] & "") + replaceSubstring(phos[start::stop], rhs, numbering) ..
                                .. + (lists.sum phos[stop::len phos] & "")
given :
    phos = pho.split word
    lhs, rhs = decompose pattern 
    searchFrom = (isFinal : len(phos)-len(lhs) ; else : 0)
    searchTo = (isInitial : 1 ; else : 1 + len(phos)-len(lhs))
    isInitial, isFinal = isInitialOrFinal pattern
    numbering = pattern -> parse -> that[right] -> listify -> getNumbers(that)
    start = matchIn(word, searchFrom::searchTo, lhs)
    stop = start + len lhs

// Assimilates a map of words to a phoneme set.
assimilate(words map, target set) :
    from M = map() for k::v = range words :
        M with (assimilate k, target)::v

// Assimilates a word to a phoneme set.
assimilate(word string, target set) :
    from a = "" for i::ph = range pho.split word :
        a + pho.closest(ph, target)

// Replaces a substring of a word with its nearest match to the pattern in the rhs.
replaceSubstring(phos list, rhs list, numbering list) : 
    from a = "" for i::target = range rhs : 
        ph == "" and len(rhs[i]) != 1 :
            error "not enough phonemes on left-hand side of pattern"
        else :
            a + pho.closest(ph, rhs[i])
    given :
        ph = (numbering[i] >= len(phos) : "" ; else : phos[numbering[i]])


// Expects a pattern of the form `lhs > rhs` and turns it into two lists of sets
// of phonemes.
decompose(pattern snippet) :
    ast in BinaryNode and ast[operator] == ">" :
        (leftList >> evaluateSet), (rightList >> evaluateSet)
    else :
        error "expected `>`"
given :
    ast = parse pattern 
    leftList = listify ast[left]
    rightList = listify ast[right]

isInitialOrFinal(pattern snippet) :
    (lhs[0] in PrefixNode and lhs[0][prefix] == "initial") ,
 .. (lhs[len(lhs)-1] in PrefixNode and lhs[len(lhs)-1][prefix] == "final")
given :
    lhs = pattern -> parse -> that[left] -> listify
     
// We want a list of numbers for the RHS of the list corresponding to the numbers of the phonemes
// on the RHS that we want to consume.
// As we construct the list, we'll zero-index everything.    
getNumbers(nodes list) -> list :
    from L = [] for i::node = range nodes :
        node in NumberNode :
            L & node[value] - 1
        node in BinaryNode and node[operator] == "." :
            node[right] in NumberNode :
                L & node[right][value] - 1
            else : 
                error "expected number on right-hand side of `.`"
        L == [] :
            [0]
        else :
            L & L[i-1]+1


// Returns the position of the first substring of the word to match the pattern
// given in `sets`, or `NULL` if there is no match.
matchIn(word string, bounds pair, sets list) -> int? :
    len sets == 0 :
        NULL 
    else :
        from a = NULL for _::i = range bounds :
            matchAt word, i, sets :
                break i
            else :
                continue

// Returns true if the pattern matches the word at the given position.
matchAt(word string, pos int, sets list) -> bool :
    from a = true for i::j = range pos::pos+len(sets) :
        phos[j] in sets[i] :
            continue 
        else :
            break false
given :
    phos = pho.split(word)
    

// This splits the node into pieces at the commas.
listify(n Node) :
    n in BinaryNode and n[operator] == "," :
        listify(n[left]) + listify(n[right])
    else :
        [n]

