import 

pho::"phonemes.pf"
"lists"
NULL::"files"

include

"lexer.pf"
"printer.pf"
"evaluator.pf"
"parser.pf"

newtype

Rule = struct(flavor string, body snippet)

var

words = map()
rules = []
currentFile string? = NULL

cmd

~~ Adds a list of words to the vocab list.
add(sn snippet) :
    retcon len(rules), sn

~~ Borrows words into the language, conforming them to the phoneme inventory.
borrow(sn snippet) :
    words = (combine words, (sn -> tokenize -> parseWordList -> assimilate(that, inv)))
given :
    inv = getPhonemesFrom words

~~ Deletes words from the vocab list.
delete(sn snippet) :
    words = words without ((sn -> makeString -> strings.split that, "\n") ...)

~~ Creates a permanent law of the phonology.
fix(sn snippet) :
    rules = rules & Rule("fix", sn)
    words = fixAll(words, (rules ?> that[flavor] == "fix"))

~~ Shows the history of the sound changes.
history :
    rules == [] :
        post "No history has happened yet."
    else :
        post ppRules rules

~~ Lists the phonemes currrently in the language.
inventory :
    post getPhonemesFrom words

~~ Merges a file containing a list of words into the vocab.
merge(filename string) :
    get text from File(filename)
    add snippet(text)

~~ Adds a note to the history.
note(sn snippet) :
   rules = rules & Rule("note", sn)

~~ Deletes the entire vocab and history.
nuke :
    words = map()
    rules = []

~~ Opens a saved project.
open (filename string):
    get text from File(filename)
    data = [(eval text)] // TODO --- this is a hack because `eval` is behaving weirdly when returning tuples.
    currentFile = filename
    words = data[0]
    rules = data[1]

~~ Retcons a list of words into the vocab list at the start.
retcon(sn snippet) :
    retcon 0, sn

~~ Retcons a list of words into the vocab list at a point just prior to event `i`.
retcon(i int, sn snippet) :
    words = (combine words, 
                  .. (sn -> tokenize -> parseWordList ..
                      .. -> apply that, (rules[i::len rules] ?> that[flavor] == "shift"))) ..
         .. -> fixAll(that, (rules ?> that[flavor] == "fix"))

~~ Retcons a file containing a list of words into the vocab at the start.
retcon merge(filename string) :
    get text from File(filename)
    retcon 0, snippet(text)

~~ Retcons a file containing a list of words into the vocab at the start.
retcon merge(i int, filename string) :
    get text from File(filename)
    retcon i, snippet(text)

~~ Saves the project to the given file.
save as (filename string) :
    put (literal words, rules) into File(filename)
    currentFile = filename

save :
    currentFile in string :
        save as currentFile
    else :
        error "you can't use `save` before you've used `save as` to select a filename"

~~ Applies a sound change.
shift(sn snippet) :
    words = changeAll(words, sn) -> fixAll(that, (rules ?> that[flavor] == "fix"))
    rules = rules & Rule("shift", sn)

~~ Displays the vocab list.
vocab :
    post display words
    
def       

~~ Returns the phonemes matching a given pattern.
phonemes(sn snippet) :
    sn -> parse -> evaluateSet

private

fixAll(words map, rules list) :
    from M = words for :
        M == newWords :
            break M 
        else :
            newWords
    given : newWords = apply(M, rules)

getPhonemesFrom(words map) :
    from S = set() for k::_ = range words :
        S + set(pho.split(k) ...)

apply(words map, rules list) :
    from M = words for _::rule = range rules :
        changeAll(M, rule[body])

changeAll(words map, sn snippet) :
    from M = map() for k::v = range words :
        M plus ((replaceAll k, sn)::v)

combine(M, N map) :
    from m = M for k::v = range N :   
        m plus (k::v)

(M map) plus (P pair) -> map :
    P[0] in keys M :
        M with P[0]::M[P[0]]+", "+P[1]
    else :
        M with P

match(word string, pattern snippet) :
    (pattern -> parse -> listify), (word -> pho.split)

replaceAll(word string, pattern snippet) : 
    from a = word for :
        newWord == a :
            break
        else :
            newWord
    given :
        newWord = replaceOnce a, pattern

replaceOnce(word string, pattern snippet) :
    start in null :
        word 
    else :
        (lists.sum phos[0::start] & "") + replaceSubstring(phos[start::stop], rhs) ..
                                .. + (lists.sum phos[stop::len phos] & "")
given :
    phos = pho.split word
    lhs, rhs = decompose pattern 
    start = matchIn(word, 0::(1 + len(phos) - len(lhs)), lhs)
    stop = start + len lhs

// Assimilates a map of words to a phoneme set.
assimilate(words map, target set) :
    from M = map() for k::v = range words :
        M with (assimilate k, target)::v

// Assimilates a word to a phoneme set.
assimilate(word string, target set) :
    from a = "" for i::ph = range pho.split word :
        a + pho.closest(ph, target)

// Replaces a substring of a word with its nearest match to the pattern in the rhs.
replaceSubstring(phos list, rhs list) :
    from a = "" for i::ph = range phos :
        a + pho.closest(ph, rhs[i])

// Expects a pattern of the form `lhs > rhs` and turns it into two lists of sets
// of phonemes.
decompose(pattern snippet) :
    ast in BinaryNode and ast[operator] == ">" :
        makeSets(ast[left]), makeSets(ast[right])
    else :
        error "expected `>`"
given :
    ast = parse pattern 

// Turns a comma-separated node into a pattern given as a list of sets.
makeSets(n Node) :
    n -> listify >> evaluateSet

// Returns the position of the first substring of the word to match the pattern
// given in `sets`, or `NULL` if there is no match.
matchIn(word string, bounds pair, sets list) -> int? :
    len sets == 0 :
        NULL 
    else :
        from a = NULL for _::i = range bounds :
            matchAt word, i, sets :
                break i
            else :
                continue

// Returns true if the pattern matches the word at the given position.
matchAt(word string, pos int, sets list) -> bool :
    from a = true for i::j = range pos::pos+len(sets) :
        phos[j] in sets[i] :
            continue 
        else :
            break false
given :
    phos = pho.split(word)
    

// This splits the node into pieces at the commas.
listify(n Node) :
    n in BinaryNode and n[operator] == "," :
        listify(n[left]) + listify(n[right])
    else :
        [n]

